# Jeton Cloudflare pour `wrangler d1 create` et `npm run server:deploy*`
# depuis le conteneur `tools` — jamais nécessaire pour `dev` ou `verify`.
# Créé sur le tableau de bord Cloudflare, gabarit « Edit Cloudflare Workers »,
# porté sur le compte et la zone w23.fr.
CLOUDFLARE_API_TOKEN=

# Seulement si le jeton voit plusieurs comptes et que wrangler le demande.
CLOUDFLARE_ACCOUNT_ID=

# Le client OAuth Google, pour lancer wrangler d'ici. L'id n'est pas un
# secret — il part dans l'URL d'autorisation — et vit aussi dans
# server/wrangler.jsonc ; le secret ne doit exister qu'ici et chez Cloudflare.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Les secrets que le Worker lit à l'exécution — SESSION_SECRET et
# GOOGLE_CLIENT_SECRET — ne se déploient pas avec lui : ils se posent une fois
# par environnement avec `wrangler secret put` et vivent chez Cloudflare.
# Qui lit quoi, où ça se pose et comment créer le client Google :
# docs/SECRETS.md.
