{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Le noyau doit tourner en Node comme en navigateur. Retirer "DOM" de lib
    // et vider "types" fait de tout accès à document, window, fetch ou
    // process une erreur de compilation, pas une convention à surveiller.
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["**/*.ts"]
}
