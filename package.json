{
  "name": "g-surge",
  "version": "1.1.2",
  "private": true,
  "description": "Endless antigrav runner built on three.js r128.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p src/sim && tsc -p src/client && tsc -p tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "docker compose --profile tools run --rm e2e",
    "test:e2e:update": "docker compose --profile tools run --rm e2e npx playwright test --update-snapshots",
    "verify:all": "npm run verify && npm run test:e2e",
    "fixtures:update": "UPDATE_FIXTURES=1 vitest run tests/sim-parity.test.ts",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e:host": "playwright test",
    "docs:tuning": "UPDATE_DOCS=1 vitest run tests/gameplay-doc.test.ts",
    "docs:layout": "UPDATE_DOCS=1 vitest run tests/layout-doc.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.128.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.128.0"
  }
}
