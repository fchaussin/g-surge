// Le serveur : un Worker, un Durable Object, une base D1. Voir docs/NETWORK.md.
//
// `main` est le bundle de scripts/build-server.mjs et non la source : c'est
// esbuild qui estampille le condensé du noyau, et un seul chemin de bundling
// sert aux tests (Miniflare), à `wrangler dev` et au déploiement.
//
// Deux environnements. Sans `--env`, la production : le Worker que le jeu
// servi sur w23.fr appelle. `staging` est celui des préversions Pages, sur
// *.pages.dev ; chacun a sa base, pour qu'un essai de branche ne classe pas
// une partie sur le tableau de tout le monde. Les identifiants D1 viennent de
// `wrangler d1 create gsurge` et `gsurge-staging`, au premier déploiement.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "g-surge-api",
  "main": "dist/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "gsurge-api.w23.fr", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ARBITER", "class_name": "Arbiter" }],
  },
  // SQLite, pas le stockage clé-valeur : c'est le seul disponible sur le plan gratuit.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Arbiter"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gsurge",
      "database_id": "8c63a59d-d062-4bbf-b9f0-ac864db01c18",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "g-surge-api-staging",
      // Pas de domaine personnalisé : les préversions vivent déjà sur des
      // URLs éphémères en *.pages.dev, un sous-domaine fixe en w23.fr
      // n'apporterait rien et coûte le même souci de certificat que la
      // production. workers.dev est déjà couvert par son propre certificat.
      "workers_dev": true,
      // Sans ce tableau vide, l'environnement hérite des `routes` du
      // sommet du fichier — le domaine personnalisé de la production —
      // et un déploiement de staging le lui reprend. Vécu une fois.
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "ARBITER", "class_name": "Arbiter" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gsurge-staging",
          "database_id": "7774e2c3-f1e1-4a9f-a9bf-36e58f5666bb",
          "migrations_dir": "migrations",
        },
      ],
      "observability": { "enabled": true },
    },
  },
}
